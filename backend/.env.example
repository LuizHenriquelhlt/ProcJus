# Copie para .env e ajuste os valores.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

DATABASE_URL=sqlite:///./procjus.db
CORS_ORIGINS=["http://localhost:5173"]
# Em produção (HTTPS) use true
COOKIE_SECURE=false

# Provedor de IA: gemini | openai_compat | fake
#   fake          -> respostas simuladas, sem chave (desenvolvimento e testes)
#   gemini        -> Google AI Studio (camada gratuita): https://aistudio.google.com/apikey
#   openai_compat -> qualquer API compatível com OpenAI (Groq, OpenRouter, Ollama...)
LLM_PROVIDER=fake

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exemplo com Groq (camada gratuita): https://console.groq.com/keys
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
# Caracteres de documento enviados por chamada (ajuste ao contexto/limite do modelo)
OPENAI_COMPAT_MAX_INPUT_CHARS=40000
